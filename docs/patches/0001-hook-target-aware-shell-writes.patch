+# Commands that modify their path arguments: every non-option argument is a write target.
+_WRITES_ALL_ARGS = {"rm", "rmdir", "mv", "chmod", "chown", "truncate", "touch", "tee", "unlink", "shred"}
+# Commands where only the last argument (the destination) is written.
+_WRITES_LAST_ARG = {"cp", "ln", "install", "rsync"}
+_HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?\n\s*\2\s*(?:\n|$)", re.DOTALL)
+_REDIRECT = re.compile(r"(?<![0-9&])>>?\s*(?!&)([^\s;&|<>]+)|[0-9]>>?\s*(?!&)([^\s;&|<>]+)")
+
+
+def _words(segment: str) -> list[str]:
+    try:
+        return shlex.split(segment, posix=True)
+    except ValueError:
+        return segment.split()
+
+
+def write_targets(command: str) -> list[str]:
+    """Paths a shell command would write, by redirect or by a known writing command.
+    Heredoc bodies are data (commit messages, file contents), not commands."""
+    heredoc_free = _HEREDOC.sub("\n", command)
+    targets = [a or b for a, b in _REDIRECT.findall(heredoc_free)]
+    for segment in re.split(r"\n|;|&&|\|\||\|", _REDIRECT.sub(" ", heredoc_free)):
+        words = _words(segment)
+        while words and (re.match(r"^\w+=", words[0]) or words[0] in ("sudo", "command", "env", "xargs")):
+            words = words[1:]
+        if not words:
+            continue
+        cmd, args = Path(words[0]).name, [w for w in words[1:] if not w.startswith("-")]
+        if cmd in _WRITES_ALL_ARGS:
+            targets += args
+        elif cmd in _WRITES_LAST_ARG and args:
+            targets.append(args[-1])
+        elif cmd in ("sed", "perl") and any(re.match(r"^-[a-zA-Z]*i", w) for w in words[1:]):
+            targets += args[1:]  # first non-option arg is the script
+        elif cmd == "git" and args[:1] in (["checkout"], ["restore"], ["rm"], ["mv"]) and "--" in words:
+            targets += words[words.index("--") + 1:]
+        elif cmd == "git" and args[:1] in (["rm"], ["mv"], ["restore"]):
+            targets += args[1:]
+    return [t for t in targets if t and t != "/dev/null"]
+
+
+def _protected_hit(root: Path, target: str, protected: list[str]) -> str | None:
+    rel = policy.relative(root, target)
+    if rel is None:
+        return None
+    if rel in ("", "."):
+        return "repository root"
+    # A directory argument (e.g. `rm -r policy`) covers everything below it.
+    return policy.matches(rel, protected) or policy.matches(rel.rstrip("/") + "/x", protected)
 
 
